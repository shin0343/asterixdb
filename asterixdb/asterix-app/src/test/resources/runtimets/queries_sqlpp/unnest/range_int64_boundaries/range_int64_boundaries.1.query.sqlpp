-- param timeout=30s
SELECT VALUE (SELECT VALUE r FROM range(b.lo, b.hi) AS r LIMIT 3)
FROM [
    {"id": 1, "lo": int64("9223372036854775807"), "hi": int64("9223372036854775807")},
    {"id": 2, "lo": int64("9223372036854775806"), "hi": int64("9223372036854775807")},
    {"id": 3, "lo": -1, "hi": 1},
    {"id": 4, "lo": int64("-9223372036854775808"), "hi": int64("-9223372036854775807")},
    {"id": 5, "lo": int64("9223372036854775807"), "hi": int64("-9223372036854775808")},
    {"id": 6, "lo": int64("-9223372036854775808"), "hi": int64("-9223372036854775808")},
    {"id": 7, "lo": int64("9223372036854775807"), "hi": int64("9223372036854775807")}
] AS b
ORDER BY b.id;
