// Fractional and NaN positions must be rejected in either argument.
SELECT VALUE {"id": t.id, "result": array_swap([1, 2, 3], t.old, t.`new`)}
FROM [
  {"id": 1, "old": 0, "new": 1.5},
  {"id": 2, "old": 0, "new": -1.5},
  {"id": 3, "old": 0, "new": float("1.5")},
  {"id": 4, "old": 0, "new": float("-1.5")},
  {"id": 5, "old": 0, "new": double("NaN")},
  {"id": 6, "old": 0, "new": float("NaN")},
  {"id": 7, "old": 1.5, "new": 1},
  {"id": 8, "old": double("NaN"), "new": 1},
  {"id": 9, "old": 0, "new": 2.0},
  {"id": 10, "old": 0, "new": -1.0},
  {"id": 11, "old": 0, "new": float("2.0")},
  {"id": 12, "old": 2.0, "new": 0.0},
  {"id": 13, "old": 0, "new": double("INF")},
  {"id": 14, "old": 0, "new": double("-INF")}
] AS t
ORDER BY t.id;
